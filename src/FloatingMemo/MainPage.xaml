<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FloatingMemo.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:FloatingMemo.Controls"
    xmlns:local="using:FloatingMemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            "Lightweight styling": override the brushes the standard controls use, instead of
            re-templating them. The editor loses its box so the text sits directly on the glass,
            and the control bar buttons become quiet, borderless icons.
            Only Light/Dark are overridden; High Contrast keeps the system's accessible colors.
        -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />

                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush" />

                    <!-- Liquid glass: an opaque "paper" body inside translucent glass. -->
                    <SolidColorBrush x:Key="PaperBrush" Color="#FFE4E8EE" />
                    <SolidColorBrush x:Key="PaperBorderBrush" Color="#40FFFFFF" />
                    <LinearGradientBrush x:Key="PaperHighlightBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#A6FFFFFF" />
                        <GradientStop Offset="0.35" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassTintBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#14FFFFFF" />
                        <GradientStop Offset="1" Color="#05FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Offset="0" Color="#29FFFFFF" />
                        <GradientStop Offset="0.3" Color="#0AFFFFFF" />
                        <GradientStop Offset="0.55" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#08FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#8CFFFFFF" />
                        <GradientStop Offset="0.5" Color="#24FFFFFF" />
                        <GradientStop Offset="1" Color="#1AFFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassShadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.8" Color="#00000000" />
                        <GradientStop Offset="1" Color="#14000000" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#24FFFFFF" />
                        <GradientStop Offset="1" Color="#0AFFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#73FFFFFF" />
                        <GradientStop Offset="1" Color="#14FFFFFF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="GlassBarBottomBrush" Color="#33000000" />
                    <LinearGradientBrush x:Key="TabChipActiveBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#4DFFFFFF" />
                        <GradientStop Offset="1" Color="#1FFFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="TabChipBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#99FFFFFF" />
                        <GradientStop Offset="1" Color="#1AFFFFFF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="TabChipHoverBrush" Color="#1AFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />

                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush" />

                    <!-- Liquid glass: an opaque "paper" body inside translucent glass. -->
                    <SolidColorBrush x:Key="PaperBrush" Color="#FFE8EDF3" />
                    <SolidColorBrush x:Key="PaperBorderBrush" Color="#241E3A5F" />
                    <LinearGradientBrush x:Key="PaperHighlightBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#D9FFFFFF" />
                        <GradientStop Offset="0.35" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassTintBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#2EFFFFFF" />
                        <GradientStop Offset="1" Color="#0FFFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Offset="0" Color="#66FFFFFF" />
                        <GradientStop Offset="0.3" Color="#1AFFFFFF" />
                        <GradientStop Offset="0.55" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#14FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#D9FFFFFF" />
                        <GradientStop Offset="0.5" Color="#4DFFFFFF" />
                        <GradientStop Offset="1" Color="#33FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassShadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.75" Color="#00000000" />
                        <GradientStop Offset="1" Color="#0A1E3A5F" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#73FFFFFF" />
                        <GradientStop Offset="1" Color="#33FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GlassBarBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#F2FFFFFF" />
                        <GradientStop Offset="1" Color="#40FFFFFF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="GlassBarBottomBrush" Color="#141E3A5F" />
                    <LinearGradientBrush x:Key="TabChipActiveBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FAFFFFFF" />
                        <GradientStop Offset="1" Color="#C2FFFFFF" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="TabChipBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="1" Color="#59FFFFFF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="TabChipHoverBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
                <!-- High contrast: system colors only, no translucency. -->
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PaperBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PaperBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <SolidColorBrush x:Key="PaperShadowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="GlassTintBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="GlassSheenBrush" Color="Transparent" />
                    <StaticResource x:Key="GlassEdgeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <SolidColorBrush x:Key="GlassShadeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="PaperHighlightBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="GlassBarBottomBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TabChipHoverBrush" Color="Transparent" />
                    <StaticResource x:Key="GlassBarBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="GlassBarBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="TabChipActiveBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="TabChipBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Slow pulse for the recording dot. -->
            <Storyboard x:Key="RecordingPulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation
                    Storyboard.TargetName="RecordingDot"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0.25"
                    Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <!-- Ctrl+R starts/stops recording without leaving the keyboard. -->
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRecordAcceleratorInvoked" />
        <!-- Note/tab commands (see OnNoteCommand). -->
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNoteCommand" />
        <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnNoteCommand" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnNoteCommand" />
        <KeyboardAccelerator Key="T" Modifiers="Control,Shift" Invoked="OnNoteCommand" />
        <KeyboardAccelerator Key="F2" Invoked="OnNoteCommand" />
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnNoteCommand" />
        <KeyboardAccelerator Key="E" Modifiers="Control,Shift" Invoked="OnNoteCommand" />
    </Page.KeyboardAccelerators>

    <!-- PreviewKeyDown: Ctrl+Tab must switch tabs before the editor turns it into a tab character. -->
    <Grid Padding="6,0,6,6" PreviewKeyDown="OnPagePreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The glass "vessel", in layers over the window's acrylic (which blurs and lightens the
            desktop behind it):
              1. a faint cool tint, lighter at the top;
              2. a diagonal reflection, as if light falls on the glass from the upper left;
              3. a little depth at the bottom edge;
              4. a bright rim along the window edge, strongest at the top.
            Purely visual: none of it takes clicks (the tab strip's drag area stays usable).
        -->
        <Grid Grid.RowSpan="5" Margin="-6,0,-6,-6" IsHitTestVisible="False">
            <Grid x:Name="VesselTint">
                <Border Background="{ThemeResource GlassTintBrush}" />
                <Border Background="{ThemeResource GlassShadeBrush}" />
            </Grid>
            <Border Background="{ThemeResource GlassSheenBrush}" />
            <Border BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="8" />
        </Grid>

        <!--
            Tab strip in the title-bar area (no extra row of chrome): tabs, "+", the note list,
            and an empty remainder that is the window's drag handle. Windows draws the close
            button over its right end.
        -->
        <Grid x:Name="TabStrip" Grid.Row="0" Margin="-6,0,-6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Padding="6,0,0,0">
                <ScrollViewer
                    x:Name="TabScroller"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    PointerWheelChanged="OnTabScrollerWheel"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="TabItemsPanel" Orientation="Horizontal" Spacing="2" />
                </ScrollViewer>
                <Button
                    x:Name="NewNoteButton"
                    Width="28"
                    Height="26"
                    Margin="2,3,0,0"
                    Padding="0"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="新規ノート"
                    Click="OnNewNoteClick"
                    ToolTipService.ToolTip="新規ノート (Ctrl+N)">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
                <Button
                    x:Name="NoteListButton"
                    Width="28"
                    Height="26"
                    Margin="0,3,0,0"
                    Padding="0"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="ノート一覧"
                    Click="OnNoteListClick"
                    ToolTipService.ToolTip="保存済みノートの一覧 (Ctrl+O)">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>
            </StackPanel>
            <!-- Drag handle: MainWindow passes it to SetTitleBar. -->
            <Grid x:Name="DragHandle" Grid.Column="1" Background="Transparent" />
        </Grid>

        <!--
            The text is the protagonist: no box, generous padding, a comfortable size, and a
            font list that falls back to Japanese UI fonts for kana/kanji.
            IsSpellCheckEnabled is off so Markdown syntax (#, -, **) is not underlined.
        -->
        <!--
            The memo body is opaque "paper" so text stays crisp and readable whatever is behind
            the window. A soft shadow (a slightly lower, blurred-looking copy) lifts it off the
            glass. The editors inside always use the light theme: dark text and a dark cursor on
            the white paper, even when Windows is in dark mode.
        -->
        <!-- Host for a blurred drop shadow under the paper (created in code, see CreateShadows). -->
        <Border
            x:Name="PaperShadowHost"
            Grid.Row="1"
            Margin="0,1,0,0"
            IsHitTestVisible="False" />
        <Border
            x:Name="PaperCard"
            Grid.Row="1"
            Margin="0,1,0,0"
            Background="{ThemeResource PaperBrush}"
            BorderBrush="{ThemeResource PaperBorderBrush}"
            BorderThickness="1"
            CornerRadius="10" />
        <!--
            Why the editors sit 4px inside the card: a Border's CornerRadius rounds only its own
            background and border, not its children, and WebView2 always draws an opaque rectangle
            that neither transparency nor composition clips affect (verified on this WinUI 3 /
            WebView2 version). Inset by at least r(1 - 1/sqrt 2) = 3px from a radius-10 corner, the
            rectangle lies entirely inside the rounded card, so only the card's own curve forms the
            corner. The page paints exactly the card's paper color, so the edge is invisible.
        -->
        <Grid x:Name="PaperContent" Grid.Row="1" Margin="4,5,4,4" RequestedTheme="Light">
        <TextBox
            x:Name="MemoTextBox"
            TabIndex="0"
            Padding="10,4,10,8"
            AutomationProperties.Name="メモ"
            AcceptsReturn="True"
            FontFamily="Segoe UI Variable Text, Yu Gothic UI, Meiryo UI"
            FontSize="15"
            IsSpellCheckEnabled="False"
            PlaceholderText="メモを書く…"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap" />

        <!--
            Markdown live-preview editor (CodeMirror 6 in WebView2). Hidden until it has loaded;
            the plain text box above is used meanwhile, and as the fallback if WebView2 fails.
        -->
        <WebView2
            x:Name="EditorWebView"
            TabIndex="0"
            Visibility="Collapsed" />

        <!--
            Every tab has been closed. Tabs are only a workspace: the notes are still saved and
            can be opened again from the list. Nothing is created until the user asks.
        -->
        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="EmptyStateText"
                FontSize="15"
                Text="開いているノートはありません" />
            <TextBlock
                MaxWidth="300"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="ノートはすべて保存されています。一覧から開くか、新しいノートを作成してください。"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="EmptyOpenListButton"
                    AutomationProperties.AutomationId="EmptyOpenList"
                    Click="OnNoteListClick"
                    Content="ノート一覧 (Ctrl+O)" />
                <Button
                    AutomationProperties.AutomationId="EmptyNewNote"
                    Click="OnNewNoteClick"
                    Content="新規ノート (Ctrl+N)" />
            </StackPanel>
        </StackPanel>
        </Grid>

        <!-- A faint light rim along the top of the paper, drawn over the text area (no clicks). -->
        <Border
            Grid.Row="1"
            Margin="0,1,0,0"
            BorderBrush="{ThemeResource PaperHighlightBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False" />

        <!-- Shown only when saving/loading fails; the memo text stays in the editor. -->
        <InfoBar
            x:Name="SaveErrorBar"
            Grid.Row="2"
            Margin="4,4,4,0"
            AutomationProperties.AutomationId="SaveErrorBar"
            IsOpen="False"
            IsTabStop="False"
            Severity="Error"
            Title="保存できませんでした" />

        <!-- Recording / transcription problems and results. -->
        <InfoBar
            x:Name="AudioInfoBar"
            Grid.Row="3"
            Margin="4,4,4,0"
            AutomationProperties.AutomationId="AudioInfoBar"
            IsOpen="False"
            IsTabStop="False" />

        <!--
            Quiet control bar: dimmed while typing, full strength on hover or while
            recording/transcribing. AllowFocusOnInteraction="False" keeps keyboard focus in
            the editor when a control is clicked.
        -->
        <!-- The bottom strip is a separate pane of glass lying on the vessel: fill, bright upper rim, shadow. -->
        <Border
            x:Name="BarShadowHost"
            Grid.Row="4"
            Margin="6,9,6,2"
            IsHitTestVisible="False" />
        <Border
            x:Name="BarGlass"
            Grid.Row="4"
            Height="36"
            Margin="0,5,0,0"
            Background="{ThemeResource GlassBarBrush}"
            BorderBrush="{ThemeResource GlassBarBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False" />
        <!-- Thickness: a faint darker line along the bottom edge of the pane. -->
        <Border
            x:Name="BarDepth"
            Grid.Row="4"
            Height="36"
            Margin="1,5,1,0"
            BorderBrush="{ThemeResource GlassBarBottomBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="10"
            IsHitTestVisible="False" />
        <Grid
            x:Name="ControlBar"
            Grid.Row="4"
            Height="36"
            Margin="0,5,0,0"
            Padding="0,0,2,0"
            Background="Transparent"
            ColumnSpacing="2"
            Opacity="0.55"
            PointerEntered="OnControlBarPointerEntered"
            PointerExited="OnControlBarPointerExited">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Grid.OpacityTransition>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- AI minutes (local LLM): create from the open transcript, or switch between the two. -->
            <Button
                x:Name="MinutesButton"
                Grid.Column="1"
                Width="34"
                Height="32"
                Padding="0"
                AllowFocusOnInteraction="False"
                AutomationProperties.AutomationId="MinutesButton"
                AutomationProperties.Name="AI議事録"
                ToolTipService.ToolTip="AI議事録（PC内のAIで作成）">
                <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="MinutesMenu" Opening="OnMinutesMenuOpening" Placement="TopEdgeAlignedRight" />
                </Button.Flyout>
            </Button>

            <!--
                Left side of the control strip: recording / transcription status, and next to it
                the AI-minutes status (a separate job that can run while the user records or types).
                State is spelled out in text, not conveyed by color alone.
            -->
            <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel
                x:Name="RecordingIndicator"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <Ellipse
                    x:Name="RecordingDot"
                    Width="8"
                    Height="8"
                    Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="14"
                    Height="14"
                    IsActive="False"
                    Visibility="Collapsed" />
                <!-- Whisper: real progress (share of the speech processed), with the percentage. -->
                <ProgressBar
                    x:Name="TranscribeBar"
                    Width="56"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TranscribeProgress"
                    AutomationProperties.Name="文字起こしの進捗"
                    Maximum="100"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="RecordingStatusText"
                    AutomationProperties.AutomationId="RecordingStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!--
                AI minutes: the model's progress cannot be measured as a percentage (the length of
                the answer is unknown), so it shows the step, elapsed time and characters written.
            -->
            <StackPanel
                x:Name="MinutesIndicator"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <ProgressBar
                    x:Name="MinutesBar"
                    Width="32"
                    VerticalAlignment="Center"
                    IsIndeterminate="True" />
                <FontIcon x:Name="MinutesStateIcon" FontSize="12" Visibility="Collapsed" />
                <TextBlock
                    x:Name="MinutesStatusText"
                    AutomationProperties.AutomationId="MinutesStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            </StackPanel>

            <ToggleButton
                x:Name="MicToggle"
                Grid.Column="2"
                Width="34"
                Height="32"
                Padding="0"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="マイク"
                Checked="OnSourceToggled"
                ToolTipService.ToolTip="マイクを録音する"
                Unchecked="OnSourceToggled">
                <controls:AudioLevelIcon x:Name="MicIcon" />
            </ToggleButton>

            <!--
                Small menu next to the microphone: which recording device to use. The list is
                rebuilt each time it opens; it is disabled while recording.
            -->
            <Button
                x:Name="MicDeviceButton"
                Grid.Column="3"
                Width="16"
                Height="32"
                Margin="-2,0,2,0"
                Padding="0"
                AllowFocusOnInteraction="False"
                AutomationProperties.AutomationId="MicDeviceButton"
                AutomationProperties.Name="マイクの入力デバイス"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="マイクの入力デバイスを選ぶ">
                <FontIcon FontSize="8" Glyph="&#xE70D;" />
                <Button.Flyout>
                    <MenuFlyout x:Name="MicDeviceMenu" Opening="OnMicDeviceMenuOpening" Placement="TopEdgeAlignedRight" />
                </Button.Flyout>
            </Button>

            <ToggleButton
                x:Name="SystemAudioToggle"
                Grid.Column="4"
                Width="34"
                Height="32"
                Padding="0"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="PC音声"
                Checked="OnSourceToggled"
                ToolTipService.ToolTip="PC音声（再生中の音）を録音する"
                Unchecked="OnSourceToggled">
                <controls:AudioLevelIcon x:Name="SystemAudioIcon" />
            </ToggleButton>

            <Button
                x:Name="RecordButton"
                Grid.Column="5"
                Width="34"
                Height="32"
                Padding="0"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="録音開始"
                Click="OnRecordClick"
                ToolTipService.ToolTip="録音開始 (Ctrl+R)">
                <FontIcon
                    x:Name="RecordIcon"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE7C8;" />
            </Button>
        </Grid>
    </Grid>
</Page>
