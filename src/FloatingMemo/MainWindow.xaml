<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FloatingMemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:FloatingMemo.Controls"
    xmlns:local="using:FloatingMemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FloatingMemo"
    mc:Ignorable="d">
    <!--
        Desktop Acrylic tuned into a lighter, clearer glass (see LiquidGlassBackdrop). It blurs
        what is behind the window, and Windows automatically falls back to a solid color when
        transparency effects are turned off (Settings > Accessibility) or in battery saver.
    -->
    <Window.SystemBackdrop>
        <controls:LiquidGlassBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <!-- Fades content in when the memo is summoned; short enough not to delay typing. -->
        <Grid.OpacityTransition>
            <ScalarTransition Duration="0:0:0.12" />
        </Grid.OpacityTransition>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <!--
            The page draws the whole surface, including the top strip with the tabs; its empty
            part is registered as the window's drag region (see MainWindow.xaml.cs).
        -->
        <Frame x:Name="RootFrame" />
    </Grid>
</Window>
